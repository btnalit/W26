{
  "schema_version": "wc26.cron_manifest.v2",
  "profile": "wc26-handicap-analyst",
  "jobs": [
    {
      "name": "wc26-fixture-collect",
      "profile": "wc26-handicap-analyst",
      "script": "wc26-fixture-collect.py",
      "required": true,
      "schedule": "*/30 * * * *",
      "deliver": "local",
      "mode": "no-agent",
      "workdir": "/hermesdata/worldcup-2026-handicap",
      "prompt": "Run deterministic WC26 fixture collection payload.",
      "env": {
        "WC26_FORCE_REFRESH": "1",
        "WC26_FIXTURE_TTL_MINUTES": "0"
      }
    },
    {
      "name": "wc26-odds-broad-scan",
